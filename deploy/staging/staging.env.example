# The settings of a staging deployment. `scripts/staging.sh init` copies this
# to ~/.config/forgemind/staging/staging.env. Nothing secret belongs here:
# secrets are files in the `secrets` directory beside it.

# Where people reach the deployment: what a browser shows, without a closing
# slash. Sign-in redirects, the session cookie and every link the API writes
# are made from it, so it must be exactly the public address.
FORGEMIND_PUBLIC_URL=http://localhost:4300

# The port on this machine's loopback address the deployment listens on. The
# proxy that ends TLS for the public address passes requests on to it.
FORGEMIND_STAGING_PORT=4300

# Any setting of the API (apps/api/README.md) may follow, and reaches the
# API, the worker and the sweeper. The environment, the origins, the port,
# the database and the queue are the deployment's own and cannot be set here.
# FORGEMIND_LOG_LEVEL=INFO
# FORGEMIND_OTEL_ENDPOINT=http://collector:4318
# FORGEMIND_PRICES='{"tokens": {"example/model-a": {"input": 1, "output": 2}}}'

# GitHub itself in place of the simulated provider. With these four, the
# secrets directory must also hold github_client_secret,
# github_app_private_key and github_webhook_secret.
# FORGEMIND_GITHUB_PROVIDER=github
# FORGEMIND_GITHUB_APP_SLUG=
# FORGEMIND_GITHUB_APP_ID=
# FORGEMIND_GITHUB_CLIENT_ID=
